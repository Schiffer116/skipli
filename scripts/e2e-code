#!/usr/bin/env bash
# Prints the newest Skipli sign-in code mailed to an E2E test address
# (any address at e2e.dev.skipli.schifferarchitecture.com, see infra/e2e.tf),
# waiting up to 60s for it to arrive. Only mail received at or after SINCE
# (unix seconds, default 90s ago) counts, so take SINCE just before requesting
# the code. ADDRESS may be a bare local part; default is e2e.
#
#   since=$(date +%s); <request the code>; scripts/e2e-code "$since" e2e-myname
set -euo pipefail

export AWS_PROFILE=${AWS_PROFILE:-iamadmin-general} AWS_REGION=us-east-1
since=${1:-$(($(date +%s) - 90))}
address=${2:-e2e}
[[ $address == *@* ]] || address=$address@e2e.dev.skipli.schifferarchitecture.com
account=$(aws sts get-caller-identity --query Account --output text)
bucket=skipli-e2e-mail-$account
since_iso=$(date -u -d "@$since" +%Y-%m-%dT%H:%M:%SZ)

for _ in $(seq 30); do
  # Newest first; SES keys objects by message id, so match the To header.
  keys=$(aws s3api list-objects-v2 --bucket "$bucket" --prefix e2e/ \
    --query "reverse(sort_by(Contents[?LastModified>='$since_iso'], &LastModified))[].Key" \
    --output text)
  for key in $keys; do
    [[ $key == None ]] && continue
    if aws s3 cp --quiet "s3://$bucket/$key" - | python3 -I -c '
import email, re, sys
msg = email.message_from_binary_file(sys.stdin.buffer)
if sys.argv[1].lower() not in (msg["To"] or "").lower():
    sys.exit(1)
for part in msg.walk():
    if part.get_content_maintype() == "text":
        text = part.get_payload(decode=True).decode(part.get_content_charset() or "utf-8")
        if m := re.search(r"\b\d{8}\b", text):
            print(m.group())
            sys.exit()
sys.exit("no code in " + sys.argv[2])
' "$address" "$key"; then
      exit
    fi
  done
  sleep 2
done
echo "no sign-in mail for $address since $since_iso" >&2
exit 1
